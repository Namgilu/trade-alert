# Naver Search API: https://developers.naver.com/apps/
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# JEV-compatible System One endpoint
JEV_API_KEY=
JEV_API_URL="https://api.typesafe.ai/v1/systemone"
JEV_MODEL=jev-latest

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional tuning
THEME_LIMIT=3
STOCKS_PER_THEME=3
NEWS_PER_STOCK=10
NEWS_LOOKBACK_HOURS=24
HTTP_TIMEOUT_SECONDS=20

# Naver Stock is an undocumented public read-only endpoint and can be replaced.
THEME_LIST_URL="https://stock.naver.com/api/domestic/market/theme/list?startIdx=0&pageSize=20&sortType=changeRate"
THEME_STOCKS_URL_TEMPLATE="https://stock.naver.com/api/domestic/market/theme/{theme_id}/stocklist?marketType=ALL&orderType=up&startIdx=0&pageSize=20"
