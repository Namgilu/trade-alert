# Repository containing the workflows and the data branch.
GITHUB_REPOSITORY=Namgilu/trade-alert
GITHUB_DATA_BRANCH=data
GITHUB_WORKFLOW_REF=main

# Fine-grained PAT: Actions read/write. Add Contents read for a private repository.
GITHUB_TOKEN=

# Enables the 07:30, 08:55, and 09:10 Asia/Seoul dispatch scheduler.
# Run exactly one scheduler-enabled server instance to prevent duplicate dispatches.
SCHEDULER_ENABLED=true

# Optional: enables POST /api/dispatch/{mode} with the X-Admin-Token header.
WEB_ADMIN_TOKEN=

REPORT_CACHE_SECONDS=300
HTTP_TIMEOUT_SECONDS=20
PORT=8000
